{
  "expo": {
    "name": "먹었다",
    "slug": "med-tracker",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "med-tracker",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dumibell.medtracker",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleLocalizations": ["en", "ko"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6BA43A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.dumibell.medtracker",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "./plugins/withNoPushEntitlement.js",
      "expo-localization",
      "@react-native-community/datetimepicker"
    ]
  }
}
